APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8092
APP_DEBUG=false
APP_AUTH_DISABLED=true

DATASET_MAX_FILE_SIZE=8388608000
DATASET_CHUNK_SIZE=5242880
DATASET_RUNTIME_DIR=.runtime

# 大文件：local=本机 ``.runtime/ftp_mirror``；ftp=连下面 FTP_*（与 MySQL 可分机部署）
STORAGE_BACKEND=local

# —— 元数据 MySQL/TiDB ——
# 不设 ``DATABASE_URL`` 时，自动用 ``MYSQL_*`` 拼装 DSN（口令含特殊字符时请写转义或改用整条 DATABASE_URL）。
# 本地开发默认使用 127.0.0.1；测试/生产环境请在受控密钥文件中覆盖 MYSQL_*。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eye_research_dataset

# true=强制只用上面 MYSQL_* 拼装 DSN（忽略 .env 里整条 DATABASE_URL）；需要 TiDB/其它连接串时设为 false 并配置 DATABASE_URL。
MYSQL_COMPOSE_ONLY=true

# 若要完全自定义连接串：``MYSQL_COMPOSE_ONLY=false`` 并取消下行注释 —
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/eye_research_dataset?charset=utf8mb4
#
# ⚠️ 安全：请勿将团队「测试环境 TiDB / 生产 DSN」写入本仓库内任何会被自动 load 的 `.env` /
# `.secrets/local.env`。若 `DATABASE_URL` 指向远端 `:4000` 等 TiDB 端口，在未意识到的
# 情况下执行 `init_db` / 导入 / 脚本会污染共享环境。本地回归请优先使用：
#   bash scripts/run_local_mysql_ftp_regression.sh
# DATABASE_URL=sqlite:///./.runtime/dataset_local.db

# —— FTP（STORAGE_BACKEND=ftp 时生效；测试/生产环境请在受控密钥文件中覆盖）——
FTP_HOST=127.0.0.1
FTP_PORT=2121
FTP_USER=dataset
FTP_PASSWORD=change-me
FTP_ROOT=/dataset

# 导出结果保留与过期清理（默认 7 天；测试可将 RETENTION_DAYS 调小、SWEEP_INTERVAL 调短）
DATASET_EXPORT_RETENTION_DAYS=7
DATASET_EXPORT_EXPIRY_SWEEP_INTERVAL_SECONDS=3600
DATASET_EXPORT_EXPIRY_BATCH_SIZE=100
DATASET_EXPORT_EXPIRY_STARTUP_SWEEP=true
