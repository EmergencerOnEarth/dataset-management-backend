APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8091
APP_DEBUG=false
APP_AUTH_DISABLED=true

DATASET_MAX_FILE_SIZE=8388608000
DATASET_CHUNK_SIZE=5242880
DATASET_RUNTIME_DIR=/app/.runtime

STORAGE_BACKEND=ftp

# 容器内访问宿主机上的 MySQL / FTP（Docker Desktop Mac/Win 与各新版 Linux Docker 均支持 host.docker.internal）
MYSQL_COMPOSE_ONLY=true
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eye_research_dataset

FTP_HOST=host.docker.internal
FTP_PORT=2121
FTP_USER=dataset
FTP_PASSWORD=change-me
FTP_ROOT=/dataset

# 导出过期清理（本地 Docker 测试可将 SWEEP_INTERVAL 调为 60 便于验证）
DATASET_EXPORT_RETENTION_DAYS=7
DATASET_EXPORT_EXPIRY_SWEEP_INTERVAL_SECONDS=3600
DATASET_EXPORT_EXPIRY_BATCH_SIZE=100
DATASET_EXPORT_EXPIRY_STARTUP_SWEEP=true
